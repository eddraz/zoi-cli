{
  "tasks": {
    "dev": "deno run -E -R -W -N --allow-run --allow-sys --unstable-kv main.ts",
    "test": "deno test --allow-all"
  },
  "imports": {
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "puppeteer": "npm:puppeteer@^25.9.0",
    "turndown": "npm:turndown@^7.2.4",
    "~/": "./",
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0",
    "@std/assert": "jsr:@std/assert@1",
    "@std/async": "jsr:@std/async@^1.0.0",
    "@std/expect": "jsr:@std/expect@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "minisearch": "npm:minisearch@^7.2.0"
  },
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./*"
      ],
      "@/*": [
        "../src/*",
        "./*"
      ]
    }
  }
}
